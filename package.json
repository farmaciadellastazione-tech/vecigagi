{
  "name": "vecigagi",
  "private": true,
  "version": "0.0.0",
  "description": "LinguaeQuiz — test infrastructure (l'app gira come single-file index.html via React CDN, nessun build step in prod)",
  "scripts": {
    "test": "vitest run && node --test \"tests/**/*.test.mjs\"",
    "test:watch": "vitest",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "vitest": "^2.1.8"
  }
}
